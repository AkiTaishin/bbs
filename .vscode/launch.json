{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "掲示板+サーバー",
      "program": "${workspaceFolder}/bbs/server.js",
      "cwd": "${workspaceFolder}/bbs",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "サーバーが起動しました: (https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithEdge",
        "webRoot": "${workspaceFolder}/bbs/public"
      }
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "掲示板のみ",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/bbs/public"
    }
  ]
}
